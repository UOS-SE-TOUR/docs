           "_parent": {
            "$ref": "Pji8848r3Jo0E+8IXkNi"
           },
           "left": 20,
           "top": 631,
           "width": 519,
           "height": 26,
           "text": "findByTourId runs only when the tour is newly confirmed (NEWLY_CONFIRMED)."
          },
